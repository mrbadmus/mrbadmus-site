# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Environment / secrets
.env
.env.local
.env.*.local
*.env

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini

# Node (defensive — not currently in use)
node_modules/

# Generator output we never want to track if accidentally created
*.tmp
*.bak

# Lane 3 secrets scan output (local only, never commit)
SECRETS_SCAN_RESULT.md

# 3D Studio (MRB-186) — build artifact is published by the generator at Stage 9,
# never committed; dependencies are restored by npm install
3d-studio/dist/
3d-studio/node_modules/
# Synthetic test specimen (MRB-187) — regenerated by `npm run test-specimen`
# from tools/make_test_specimen.py. A geometry fixture, never content.
3d-studio/public/assets/_test-specimen*.glb
# Synthetic fallback plate (MRB-190) — regenerated by `npm run test-plate`
# from tools/make_test_plate.py. A geometry fixture, never content.
3d-studio/public/assets/_test-plate.svg
3d-studio/tools/build/
# Draco decoder, copied out of node_modules by vite.config.ts so the studio
# never fetches it from a Google CDN. A build input, not source.
3d-studio/public/draco/

# design-sync machine state (staged scripts, build output, caches)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# B1 comparison screenshots — 38MB of PNGs, regenerated on demand.
# The live side-by-side on localhost is the sign-off surface; these are
# the record of one run and do not belong in a repo Mide pushes.
docs/ks3/b1-comparison/*/*.png

# Claude Design's `_ds/` bundles, shipped alongside every KS3 lesson delivery
# (MRB-248, 18 Aug 2026). Not load-bearing and never were: React components,
# an oxlint adherence config, and a CSS/JS bundle that re-ships this repo's own
# shared/ks3.css. The seven woff2 files are byte-identical to shared/fonts/.
# Nothing in this repo runs that toolchain — build_ks3.py reads the .dc.html
# pages and nothing else. The pages are the delivery; _ds is its packaging.
# Kept on disk so a reviewer can still open a .dc.html locally and see it
# styled; never tracked, because 568K x 15 units of duplicate fonts is not a
# record of anything.
docs/ks3/design-reference/*/_ds/

# generated question-pool upserts (export_ks3_questions.py)
build/

# MRB-277 — the coming-soon parity fixture, written and removed by ks3_parity.py
mrbadmus_site/ks3/__fixture__/
ks3/__fixture__/
