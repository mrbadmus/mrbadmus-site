{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/BrandMark/**",
              "components/general/HotspotDot/**",
              "components/general/InfoPanel/**",
              "components/general/LibraryColumn/**",
              "components/general/LibraryDrawer/**",
              "components/general/LibraryFullScreen/**",
              "components/general/ModeToggle/**",
              "components/general/PhoneSheet/**",
              "components/general/QualityChip/**",
              "components/general/QualityPanel/**",
              "components/general/RecordSection/**",
              "components/general/RetrievalPanel/**",
              "components/general/Stage/**",
              "components/general/TabletPanel/**",
              "components/general/ToolIcon/**",
              "components/general/ToolRail/**",
              "components/general/TopBar/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Plus Jakarta Sans|Bricolage Grotesque|Instrument Sans|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Plus Jakarta Sans, Bricolage Grotesque, Instrument Sans, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='LibraryDrawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:selectedId|onSelect|onClose|keyStage|key|ref|className|style|children)$/]",
        "message": "<LibraryDrawer> doesn't accept that prop. Declared props: selectedId, onSelect, onClose, keyStage."
      },
      {
        "selector": "JSXOpeningElement[name.name='LibraryDrawer'] > JSXAttribute[name.name='keyStage'] > Literal[value!=/^(?:KS3|KS4)$/]",
        "message": "<LibraryDrawer> keyStage must be one of 'KS3' | 'KS4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LibraryFullScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:selectedId|onSelect|onClose|keyStage|key|ref|className|style|children)$/]",
        "message": "<LibraryFullScreen> doesn't accept that prop. Declared props: selectedId, onSelect, onClose, keyStage."
      },
      {
        "selector": "JSXOpeningElement[name.name='LibraryFullScreen'] > JSXAttribute[name.name='keyStage'] > Literal[value!=/^(?:KS3|KS4)$/]",
        "message": "<LibraryFullScreen> keyStage must be one of 'KS3' | 'KS4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onMode|key|ref|className|style|children)$/]",
        "message": "<ModeToggle> doesn't accept that prop. Declared props: mode, onMode."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeToggle'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:explore|retrieve)$/]",
        "message": "<ModeToggle> mode must be one of 'explore' | 'retrieve'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabletPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:specimen|openHotspotId|onOpenHotspot|onStartRetrieval|key|ref|className|style|children)$/]",
        "message": "<TabletPanel> doesn't accept that prop. Declared props: specimen, openHotspotId, onOpenHotspot, onStartRetrieval."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:tool|size|key|ref|className|style|children)$/]",
        "message": "<ToolIcon> doesn't accept that prop. Declared props: tool, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolIcon'] > JSXAttribute[name.name='tool'] > Literal[value!=/^(?:rotate|zoom|isolate|cross-section|layers|labels|reset|auto-rotate)$/]",
        "message": "<ToolIcon> tool must be one of 'rotate' | 'zoom' | 'isolate' | 'cross-section' | 'layers' | 'labels' | 'reset' | 'auto-rotate'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
